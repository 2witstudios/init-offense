#!/bin/sh
# Optional local guard. Branch snapshots may be unfinished; main requires
# verification of the exact clean candidate. GitHub main rules remain authoritative.
set -eu
refs=$(cat)
cd "$(git rev-parse --show-toplevel)"
head_commit=$(git rev-parse --verify --quiet 'HEAD^{commit}' || true)
needs_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  [ "$remote_ref" = refs/heads/main ] || continue
  commit=$(git rev-parse --verify --quiet "${local_sha}^{commit}" || true)
  if [ -z "$commit" ] || [ "$commit" != "$head_commit" ]; then
    echo "pre-push: main must be verified from the checked-out candidate." >&2
    exit 1
  fi
  needs_check=1
done <<REFS
$refs
REFS
if [ "$needs_check" -eq 0 ]; then
  echo "pre-push: branch snapshot allowed; record provisional failures and deferred proof before main acceptance." >&2
  exit 0
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: main verification requires a clean working tree matching the pushed commit." >&2
  exit 1
fi
exec bun check </dev/null
