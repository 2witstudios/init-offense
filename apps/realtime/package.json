    "@acme/db": "workspace:*",
    "@acme/logger": "workspace:*",
    "@acme/observability": "workspace:*",
    "@acme/protocol": "workspace:*",
    "@acme/redis": "workspace:*"
  },
  "devDependencies": {
    "riteway": "9.3.0"
  }
}
