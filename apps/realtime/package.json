{
  "name": "@acme/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:integration": "bun ../../scripts/test-integration.ts",
